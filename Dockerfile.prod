# =============================================================================
# Stage 1: Build des assets frontend (Vite + Vue 3)
# =============================================================================
FROM node:20-alpine AS frontend

WORKDIR /app

# Copier les fichiers de dépendances d'abord (cache Docker)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Copier le reste du code source pour le build
COPY resources ./resources
COPY vite.config.js ./
# package.json garantit au moins une correspondance : les configs postcss/tailwind
# restent optionnelles (le COPY échoue si AUCUN glob ne correspond).
COPY package.json postcss.config.js* tailwind.config.js* ./

RUN npm run build

# Garde-fou : échouer explicitement si le build n'a pas produit le manifest.
RUN test -f public/build/manifest.json || (echo "ERREUR: build front absent (public/build/manifest.json manquant)" && exit 1)


# =============================================================================
# Stage 2: Dépendances PHP (Composer)
# =============================================================================
FROM composer:2 AS composer

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs

COPY . .
RUN composer dump-autoload --optimize --no-dev


# =============================================================================
# Stage 3: Image de production
# =============================================================================
FROM php:8.4-fpm-alpine

ARG user=hospital
ARG uid=1000

# Dépendances système
RUN apk add --no-cache \
    libpng-dev \
    oniguruma-dev \
    libxml2-dev \
    postgresql-dev \
    libzip-dev \
    zip \
    unzip \
    shadow \
    curl

# Extensions PHP
RUN docker-php-ext-install pdo_pgsql pgsql mbstring exif pcntl bcmath gd zip opcache

# Configuration OPcache pour la production
RUN { \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=10000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.enable_cli=1'; \
    } > /usr/local/etc/php/conf.d/opcache-prod.ini

# Configuration PHP production
RUN { \
    echo 'upload_max_filesize=40M'; \
    echo 'post_max_size=40M'; \
    echo 'memory_limit=256M'; \
    echo 'max_execution_time=600'; \
    echo 'expose_php=Off'; \
    echo 'display_errors=Off'; \
    echo 'log_errors=On'; \
    echo 'error_log=/var/www/storage/logs/php-errors.log'; \
    } > /usr/local/etc/php/conf.d/production.ini

# Créer l'utilisateur
RUN useradd -G www-data,root -u $uid -d /home/$user $user && \
    mkdir -p /home/$user && \
    chown -R $user:$user /home/$user

WORKDIR /var/www

# Copier le code source depuis le stage composer (avec vendor/)
COPY --from=composer /app /var/www

# Copier les assets buildés depuis le stage frontend
COPY --from=frontend /app/public/build /var/www/public/build

# Copier l'entrypoint
COPY docker/entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Créer le dossier de sync pour nginx et les répertoires nécessaires
RUN mkdir -p \
    public-shared \
    storage/app/public \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache && \
    chown -R $user:www-data /var/www && \
    chmod -R 775 storage bootstrap/cache public-shared

USER $user

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]
